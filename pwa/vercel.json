{
  "crons": [
    {"path": "/api/market?cron=1", "schedule": "15 4 * * *"},
    {"path": "/api/fuel?cron=1", "schedule": "30 4 * * 1"}
  ],
  "headers": [
    {"source": "/assets/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/app-loader.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
