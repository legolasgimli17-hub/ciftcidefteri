{
  "name": "ciftci-defteri",
  "version": "0.4.0",
  "private": true,
  "description": "Offline-first, ürün-duyarlı çiftçi gelir/gider uygulaması.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "doctor": "expo-doctor@latest",
    "clean": "rm -rf dist-tests",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run clean && npm run build:test && node --test dist-tests/tests/*.test.js",
    "security:static": "node scripts/static-security-check.mjs",
    "security:mobile-config": "node scripts/mobile-security-config-check.mjs",
    "security:dependencies": "node scripts/dependency-runtime-check.mjs",
    "security:crash-privacy": "node scripts/crash-privacy-check.mjs",
    "ux:language": "node scripts/ux-language-check.mjs",
    "check:core": "npm run typecheck:core && npm test && npm run schema:drift && npm run security:static && npm run security:mobile-config && npm run security:dependencies && npm run security:crash-privacy && npm run ux:language",
    "check": "npm run check:core",
    "ci:deps": "npm audit --audit-level=high",
    "schema:drift": "node scripts/schema-drift-check.mjs"
  },
  "dependencies": {
    "@sentry/react-native": "8.18.0",
    "decode-uri-component": "file:vendor/decode-uri-component-bridge",
    "decode-uri-component-safe": "npm:decode-uri-component@0.5.0",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
